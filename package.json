{
	"name": "vscode-analytical-engine",
	"displayName": "Babbage Analytical Engine Assembly",
	"description": "Visual Studio Code tooling for Babbage Analytical Engine assembly.",
	"version": "0.1.0",
	"publisher": "benmclean",
	"icon": "icon.png",
	"homepage": "https://github.com/benmclean/vscode-analytical-engine",
	"bugs": {
		"url": "https://github.com/benmclean/vscode-analytical-engine/issues"
	},
	"license": "MIT",
	"pricing": "Free",
	"repository": {
		"type": "git",
		"url": "https://github.com/benmclean/vscode-analytical-engine.git"
	},
	"galleryBanner": {
		"color": "#e8dfbf",
		"theme": "light"
	},
	"engines": {
		"vscode": "^1.125.0"
	},
	"categories": [
		"Programming Languages",
		"Debuggers",
		"Linters",
		"Education"
	],
	"keywords": [
		"analytical-engine",
		"babbage",
		"assembly"
	],
	"activationEvents": [
		"onDebug"
	],
	"main": "./dist/node/extension.js",
	"browser": "./dist/web/extension.js",
	"contributes": {
		"commands": [
			{
				"command": "analytical-engine.runCurrentProgram",
				"title": "Babbage Analytical Engine Assembly: Run Current Program",
				"icon": "$(run-compact)"
			},
			{
				"command": "analytical-engine.debugCurrentProgram",
				"title": "Babbage Analytical Engine Assembly: Debug Current Program",
				"icon": "$(debug)"
			},
			{
				"command": "analytical-engine.newProgram",
				"title": "Babbage Analytical Engine Assembly: New Sample Program"
			},
			{
				"command": "analytical-engine.showPlotter",
				"title": "Babbage Analytical Engine Assembly: Show Plotter",
				"icon": "$(open-preview)"
			}
		],
		"configuration": {
			"title": "Analytical Engine",
			"properties": {
				"analytical-engine.plotter.autoOpen": {
					"type": "boolean",
					"default": true,
					"description": "Automatically open the plotter panel when the debugger stops."
				},
				"analytical-engine.bellSound": {
					"type": "string",
					"default": "",
					"description": "Path to a sound file to play when a Bell card (B) is executed. Leave empty for no sound. Not supported in the web extension. macOS: any format supported by afplay (MP3, WAV, AIFF, AAC). Windows: WAV files only. Linux: WAV files via aplay."
				}
			}
		},
		"languages": [
			{
				"id": "analytical-engine",
				"aliases": [
					"Analytical Engine",
					"analytical-engine"
				],
				"extensions": [
					".ae"
				],
				"configuration": "./language-configuration.json"
			}
		],
		"grammars": [
			{
				"language": "analytical-engine",
				"scopeName": "source.analytical-engine",
				"path": "./syntaxes/analytical-engine.tmLanguage.json"
			}
		],
		"snippets": [
			{
				"language": "analytical-engine",
				"path": "./snippets/analytical-engine.code-snippets"
			}
		],
		"menus": {
			"editor/title/run": [
				{
					"command": "analytical-engine.showPlotter",
					"when": "resourceExtname == .ae",
					"group": "navigation@1"
				},
				{
					"command": "analytical-engine.runCurrentProgram",
					"when": "resourceExtname == .ae",
					"group": "navigation@2"
				},
				{
					"command": "analytical-engine.debugCurrentProgram",
					"when": "resourceExtname == .ae",
					"group": "navigation@3"
				}
			]
		},
		"breakpoints": [
			{
				"language": "analytical-engine"
			}
		],
		"debuggers": [
			{
				"type": "analytical-engine",
				"label": "Analytical Engine",
				"languages": [
					"analytical-engine"
				],
				"configurationAttributes": {
					"launch": {
						"properties": {
							"program": {
								"type": "string",
								"description": "Path to the .ae file to debug. Defaults to the active file.",
								"default": "${file}"
							}
						}
					}
				},
				"initialConfigurations": [
					{
						"type": "analytical-engine",
						"request": "launch",
						"name": "Debug Analytical Engine Program",
						"program": "${file}"
					}
				],
				"configurationSnippets": [
					{
						"label": "Analytical Engine: Debug",
						"description": "Debug an Analytical Engine program",
						"body": {
							"type": "analytical-engine",
							"request": "launch",
							"name": "${1:Debug Analytical Engine Program}",
							"program": "^\"\\${file}\""
						}
					}
				]
			}
		]
	},
	"scripts": {
		"vscode:prepublish": "npm run package",
		"compile": "npm run check-types && npm run lint && node esbuild.js && node scripts/copy-analytical-engine-library.js",
		"watch": "npm-run-all -p watch:*",
		"watch:esbuild": "node esbuild.js --watch",
		"watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
		"package": "npm run check-types && npm run lint && node esbuild.js --production && node scripts/copy-analytical-engine-library.js",
		"compile-tests": "tsc -p . --outDir out",
		"watch-tests": "tsc -p . -w --outDir out",
		"pretest": "npm run compile-tests && npm run compile && npm run lint",
		"check-types": "tsc --noEmit",
		"lint": "eslint src",
		"test": "vscode-test",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"vsix": "vsce package --out analytical-engine.vsix",
		"publish:vsce": "vsce publish",
		"publish:ovsx": "npx ovsx publish"
	},
	"dependencies": {
		"analytical-engine": "github:BenMcLean/analytical-engine#0bfbc8822563fca8c325036a7aa3156ceecb8a4c"
	},
	"devDependencies": {
		"@types/mocha": "^10.0.10",
		"@types/node": "24.x",
		"@types/vscode": "^1.125.0",
		"@vscode/test-cli": "^0.0.15",
		"@vscode/test-electron": "^3.0.0",
		"@vscode/vsce": "^3.6.2",
		"esbuild": "^0.28.1",
		"eslint": "^10.5.0",
		"npm-run-all": "^4.1.5",
		"prettier": "^3.5.3",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.61.1"
	},
	"overrides": {
		"diff": "^8.0.4",
		"serialize-javascript": "^7.0.6"
	}
}
